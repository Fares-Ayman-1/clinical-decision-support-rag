# Rendered to /etc/nginx/conf.d/default.conf at container start by the nginx
# image's entrypoint, which runs envsubst over /etc/nginx/templates/*.template.
#
# ${PORT} rather than a literal: a PaaS assigns the port at runtime and routes
# to it, so a hardcoded listen directive means the platform's health check
# never connects and the service is never marked live.
#
# NGINX_ENVSUBST_FILTER=PORT is set in the Dockerfile and is load-bearing:
# without it envsubst also rewrites nginx's own $uri below (to empty, since it
# is not an environment variable), which silently breaks SPA routing — every
# deep link would 404 instead of falling through to index.html.

server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "DENY" always;

  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(?:css|js|woff2?|svg|png|jpg|jpeg|gif|webp)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }
}
