# Copy to .env and fill in real values. Never commit .env.

# --- LLM provider (abstracted — see backend/app/llm/provider.py) ---
# anthropic | openai | ollama — swapping providers is a config change only
# (load_llm_provider() reads these vars), never a code change. ollama is
# OpenAI-compatible (config/llm.yaml documents the base_url swap).
LLM_PROVIDER=ollama
LLM_MODEL=gpt-oss:20b          # see the "available models" note below
LLM_API_KEY=                     # required for anthropic/openai; unused by ollama

# --- Ollama (only when LLM_PROVIDER=ollama) ---
# Three shapes, auto-selected:
#   1. Local model  — leave both vars unset; talks to http://localhost:11434
#   2. Cloud by key — set OLLAMA_API_KEY (https://ollama.com/settings/keys);
#                     talks to https://ollama.com/v1 directly, no daemon
#   3. Cloud by daemon — run `ollama signin`, set OLLAMA_BASE_URL to the
#                     local daemon and use a ":cloud" model tag
# OLLAMA_API_KEY takes precedence over LLM_API_KEY, so a stale key from a
# previous provider left in .env cannot be sent to Ollama by mistake.
#
# Verified free-tier models on ollama.com (2026-08-17): gpt-oss:120b,
# gpt-oss:20b, minimax-m3. Requiring a paid plan: qwen3.5:397b, glm-5.2,
# and kimi-k3 (which also needs separately-purchased extra usage credits).
OLLAMA_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Retrieval models (see PROJECT-STATE.md R12 — only MiniLM is
# downloadable in this sandbox; a 2nd candidate benchmark is deferred) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Cross-encoder for reranking (PROJECT-STATE.md §9.4). Set empty to force the
# NullReranker passthrough fallback. R12 (no HF Hub route) was resolved by the
# truststore fix — this model downloads and caches on first use (~80s cold).
# Multilingual (mMARCO incl. Arabic). bge-reranker-v2-m3 was measured at
# ~96-105s per query on both Railway and HF free CPUs - do not use it there.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Vector store ---
# Read at call time (app/api/dependencies.py qdrant_url()), so a container
# deployment can point at a service name instead of localhost.
QDRANT_URL=http://localhost:6333
# Qdrant ships with NO authentication. Leave empty for a local instance on
# your own machine; a hosted one MUST set both QDRANT__SERVICE__API_KEY on
# the server and this here, or the evidence corpus is world-writable —
# someone could alter the text behind every citation the API returns.
QDRANT_API_KEY=

# --- App storage ---
DATABASE_URL=sqlite:///./data/traces.db

# --- Observability ---
DEBUG_TRACE=true

# --- CORS (NFR-3.4) ---
# Comma-separated. Never set this to "*" — a wildcard would let any page on
# the internet submit a patient's symptoms to this backend.
FRONTEND_ORIGIN=http://localhost:5173

# --- Rate limiting (NFR-3.3) — /api/query only ---
# Sliding window, in-process. A multi-worker deployment needs a shared
# store (Redis) since counters are per worker — see TODO-PRODUCTION.md.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging (NFR-7.1) ---
# Structured JSON to stdout, request_id on every line. Two streams: "app"
# (operational) and "metrics" (scalars only, SAF-10.3).
LOG_LEVEL=INFO
