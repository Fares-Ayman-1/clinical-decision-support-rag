# faqarati (فقراتي) — in-repo copy serving as the clinical Space's UI.
#
# Einstein/copilot suggestions use the SAME Ollama cloud provider as the
# clinical backend (server/createApp.ts::ollamaJson) — no Gemini key.
OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com/v1
# LLM_MODEL=gpt-oss:20b

# Standalone dev against a remote clinical backend only; unset = same-origin
# (correct inside the Space, where nginx serves this UI and the API together).
# VITE_CLINICAL_API_URL=https://fatimahemadeldin-clinical-decision-support-rag.hf.space
