# Build context is the repo root (docker-compose.yml: context: .), so
# without this every build ships .venv, .git, and the whole data/ tree —
# gigabytes, and slow.

# SECRETS — never in a build context. .env holds a live provider API key,
# and anything COPYed into a layer is recoverable from the image even if a
# later layer deletes it.
.env
.env.*
!.env.example

# Virtualenvs and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# VCS and editor
.git/
.gitignore
.claude/
.vscode/
.idea/

# Frontend (built by its own Dockerfile with context: ./frontend)
frontend/node_modules/
frontend/dist/

# Data: excluded wholesale, then two files re-included by name.
#
# docker-compose.yml bind-mounts data/ locally, but a PaaS has no bind
# mounts — an image without these two files cannot serve a request, because
# app/api/dependencies.py opens both at startup (CHUNK_STORE_PATH and
# MVP_SOURCE_CHUNKS_PATH). They are byte-identical 14 MB files, so this adds
# ~28 MB to the image and nothing else from data/ ships.
#
# Order is load-bearing: a negation only takes effect if it FOLLOWS the
# pattern that excluded the path. `data/**` rather than `data/` so that
# re-including a file inside an excluded subdirectory works.
data/**
!data/chunk_store/medical_chunks.jsonl
!data/chunks/benchmark/1.0_S1.jsonl

# Source PDFs — copyrighted WHO/USPSTF documents, deliberately never
# committed and never shipped in an image.
*.pdf
WHO-ICRC*/

# Docs and local scratch
*.md
!README.md
